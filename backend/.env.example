# Database — SQLite for local dev (no Docker needed); change to PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///trade_agent.db
DATABASE_URL_SYNC=sqlite:///trade_agent.db
REDIS_URL=

# LLM — choose "deepseek", "anthropic", or "openai"
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx
# LLM_MODEL=claude-sonnet-4-6

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=trade_agent_verify_2024

# Agent behavior
AGENT_NAME=TradeBot
AUTO_REPLY_ENABLED=true
HUMAN_TAKEOVER_THRESHOLD=0.7
MAX_AUTO_ROUNDS=3
LARGE_ORDER_THRESHOLD_USD=10000
